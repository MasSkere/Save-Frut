# =====================================================
# CONFIGURACIÓN DE SAVEFRUT API - ARCHIVO .ENV.EXAMPLE
# =====================================================

# ── SERVICIO ────────────────────────────────────────
SERVER_PORT=8091
SPRING_PROFILE=dev

# ── BASE DE DATOS (PostgreSQL) ──────────────────────
# NOTA: Si usas Docker, el host es "postgres". Si usas IDE local, es "localhost".
DB_URL=jdbc:postgresql://postgres:5432/db_savefrut
DB_USER=savefrut_admin
DB_PASS=tu_password_seguro

# ── REDIS ───────────────────────────────────────────
# NOTA: Si usas Docker, el host es "redis".
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT (Seguridad) ─────────────────────────────────
# Generar uno nuevo con: openssl rand -base64 64
JWT_SECRET=reemplazar_con_un_secreto_largo_y_seguro
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# ── MERCADO PAGO ────────────────────────────────────
MERCADO_PAGO_ACCESS_TOKEN=tu_access_token_de_prueba
MERCADO_PAGO_PUBLIC_KEY=tu_public_key_de_prueba

# ── GOOGLE MAPS ─────────────────────────────────────
GOOGLE_MAPS_API_KEY=tu_api_key_de_google_cloud

# ── CONFIGURACIÓN DE IMÁGENES ───────────────────────
APP_IMAGE_PLACEHOLDER_URL=https://placehold.co/400x400/cccccc/999999?text=Sin+Imagen